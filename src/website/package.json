{
  "name": "Bing-Wallpaper-Archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vite": "vite build",
    "build:python": "python build_website.py",
    "build": "npm run build:vite -- --emptyOutDir && npm run build:python",
    "dev": "npm run build:vite && npm run build:python -- --dev",
    "deploy": "npm run build && wrangler deploy",
    "update": "npx npm-check-updates -u && npm install"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^8.2.3",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-html-minifier": "^1.0.5",
    "wrangler": "^4.157.0"
  },
  "browserslist": [
    "> 0.01%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
